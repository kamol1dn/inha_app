{
  "name": "iut-eclass-extension",
  "version": "0.1.0",
  "private": true,
  "description": "IUT for eClass: a new eClass with INS grades, university mail and the timetable built in.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "build:dev": "node build.mjs --dev",
    "build:firefox": "node build.mjs --firefox",
    "lint:firefox": "web-ext lint --source-dir dist-firefox",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "preact": "10.24.3"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "@types/node": "22.15.3",
    "esbuild": "0.24.0",
    "linkedom": "0.18.5",
    "typescript": "5.8.3",
    "web-ext": "8.3.0"
  }
}
